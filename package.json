{
  "name": "society-agent",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:engine": "tsx tests/engine-check.ts",
    "test:e2e": "tsx tests/e2e.ts",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "test:unit": "tsx --tsconfig tsconfig.app.json --test tests/engine.test.ts tests/lab.test.ts tests/custom.test.ts tests/layouts.test.ts tests/golden.test.ts tests/docs.test.ts tests/links.test.ts",
    "typecheck": "tsc -b",
    "test:live": "tsx tests/e2e.ts $URL && tsx tests/security.ts $URL && tsx tests/ui.ts $URL"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@tanstack/react-query": "^5.104.5",
    "framer-motion": "^13.3.0",
    "lucide-react": "^0.562.0",
    "ox": "^1.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.1",
    "viem": "^2.57.7",
    "wagmi": "^3.7.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.62.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wrangler": "^4"
  },
  "license": "MIT",
  "description": "Open-source agent-based town simulation: residents react to news, and an experiment lab tells you what really changes the outcome.",
  "overrides": {
    "ox": "$ox"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/societyagent/society-agent.git"
  },
  "homepage": "https://github.com/societyagent/society-agent#readme",
  "bugs": {
    "url": "https://github.com/societyagent/society-agent/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-based-model",
    "simulation",
    "social-simulation",
    "opinion-dynamics",
    "multi-agent",
    "cloudflare-pages",
    "react",
    "typescript"
  ]
}
